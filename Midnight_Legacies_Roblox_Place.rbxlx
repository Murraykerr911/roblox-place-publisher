  <Item class="ServerScriptService" referent="RBXd6caab28550f4813aba5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX715d5825118a4076b544">
      <Properties>
        <string name="Name">LegaciesGameServer</string>
        <ProtectedString name="Source">
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local choose = ReplicatedStorage:WaitForChild("ChooseSpecies")
local ability = ReplicatedStorage:WaitForChild("UseAbility")
local valid = {Vampire=true, Witch=true, Werewolf=true, Human=true}
local cooldowns = {}
Players.PlayerAdded:Connect(function(player)
    player:SetAttribute("Species", "Human")
    player:SetAttribute("Blood", 100)
    player:SetAttribute("Magic", 100)
    player:SetAttribute("Level", 1)
end)
choose.OnServerEvent:Connect(function(player, species)
    if typeof(species) == "string" and valid[species] then
        player:SetAttribute("Species", species)
    end
end)
ability.OnServerEvent:Connect(function(player, move)
    if typeof(move) ~= "string" then return end
    local now = os.clock()
    if cooldowns[player] and now - cooldowns[player] &lt; 4 then return end
    local species = player:GetAttribute("Species")
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if move == "Sprint" and species == "Vampire" then
        cooldowns[player] = now
        local old = hum.WalkSpeed
        hum.WalkSpeed = 30
        task.delay(5, function() if hum and hum.Parent then hum.WalkSpeed = old end end)
    elseif move == "Heal" and species == "Witch" then
        cooldowns[player] = now
        hum.Health = math.min(hum.MaxHealth, hum.Health + 35)
        player:SetAttribute("Magic", math.max(0, (player:GetAttribute("Magic") or 100)-20))
    elseif move == "Howl" and species == "Werewolf" then
        cooldowns[player] = now
        local fx = Instance.new("Explosion")
        fx.Position = hrp.Position + hrp.CFrame.LookVector * 8
        fx.BlastRadius = 8
        fx.BlastPressure = 0
        fx.DestroyJointRadiusPercent = 0
        fx.Parent = workspace
        task.delay(1, function() fx:Destroy() end)
    end
end)
Players.PlayerRemoving:Connect(function(p) cooldowns[p] = nil end)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBXe3823ff73243439487b4">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="RBXcbc6b204ff4a4269b35a">
      <Properties>
        <string name="Name">LegaciesHUD</string>
        <bool name="ResetOnSpawn">false</bool>
        <bool name="IgnoreGuiInset">true</bool>
      </Properties>
      <Item class="LocalScript" referent="RBXd8a437d57c53458a90e4">
        <Properties>
          <string name="Name">LegaciesHUDClient</string>
          <ProtectedString name="Source">
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local choose = ReplicatedStorage:WaitForChild("ChooseSpecies")
local ability = ReplicatedStorage:WaitForChild("UseAbility")
local gui = script.Parent
local frame = Instance.new("Frame")
frame.Name = "Panel"; frame.Size = UDim2.new(0, 300, 0, 245); frame.Position = UDim2.new(0, 18, 0.5, -122)
frame.BackgroundColor3 = Color3.fromRGB(17, 14, 25); frame.BackgroundTransparency = 0.08; frame.Parent = gui
local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 12); corner.Parent = frame
local stroke = Instance.new("UIStroke"); stroke.Color = Color3.fromRGB(150, 45, 75); stroke.Thickness = 2; stroke.Parent = frame
local function label(text, y, height, size)
    local l = Instance.new("TextLabel"); l.Size = UDim2.new(1, -20, 0, height); l.Position = UDim2.new(0, 10, 0, y)
    l.BackgroundTransparency = 1; l.Text = text; l.TextColor3 = Color3.fromRGB(245, 235, 245)
    l.Font = Enum.Font.GothamBold; l.TextSize = size; l.TextWrapped = true; l.Parent = frame; return l
end
label("MIDNIGHT LEGACIES", 10, 30, 20)
label("Choose your bloodline", 42, 22, 13)
local status = label("Species: Human | Level: 1", 72, 22, 12)
local function button(text, x, y, w, callback)
    local b = Instance.new("TextButton"); b.Size = UDim2.new(0, w, 0, 32); b.Position = UDim2.new(0, x, 0, y)
    b.Text = text; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.GothamBold; b.TextSize = 12
    b.BackgroundColor3 = Color3.fromRGB(89, 29, 53); b.Parent = frame
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 7); c.Parent = b
    b.Activated:Connect(callback); return b
end
button("VAMPIRE", 10, 103, 88, function() choose:FireServer("Vampire") end)
button("WITCH", 106, 103, 88, function() choose:FireServer("Witch") end)
button("WEREWOLF", 202, 103, 88, function() choose:FireServer("Werewolf") end)
button("HUMAN", 10, 143, 88, function() choose:FireServer("Human") end)
button("ABILITY", 106, 143, 88, function()
    local s = player:GetAttribute("Species")
    if s == "Vampire" then ability:FireServer("Sprint")
    elseif s == "Witch" then ability:FireServer("Heal")
    elseif s == "Werewolf" then ability:FireServer("Howl") end
end)
button("RESET VIEW", 202, 143, 88, function()
    local c = player.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then workspace.CurrentCamera.CameraSubject = h end
end)
label("Vampire: speed | Witch: heal | Werewolf: howl", 183, 45, 11)
local function refresh()
    status.Text = "Species: "..tostring(player:GetAttribute("Species") or "Human").." | Level: "..tostring(player:GetAttribute("Level") or 1)
end
for _, attr in ipairs({"Species","Level"}) do player:GetAttributeChangedSignal(attr):Connect(refresh) end
refresh()
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
