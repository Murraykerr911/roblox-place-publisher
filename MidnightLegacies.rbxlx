      <Item class="ModuleScript" referent="RBX8">
        <Properties>
          <string name="Name">QuestConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Quest Configuration
	Main story + side questlines
]]

local QuestConfig = {}

QuestConfig.Quests = {
	-- Tutorial / Intro
	WelcomeToMidnight = {
		Id = "WelcomeToMidnight",
		Title = "Welcome to Midnight",
		Description = "Arrive at the academy and meet the orientation guide.",
		Type = "Main",
		Objectives = {
			{Type = "Talk", Target = "OrientationGuide", Text = "Speak with the Orientation Guide"},
			{Type = "Explore", Target = "AcademyCourtyard", Text = "Explore the Academy Courtyard"},
		},
		Rewards = {
			XP = 50,
			Moonstones = 25,
			Title = "Newcomer",
		},
		Next = "SpeciesAwakening",
	},

	SpeciesAwakening = {
		Id = "SpeciesAwakening",
		Title = "Awakening",
		Description = "Discover or confirm your supernatural nature.",
		Type = "Main",
		Objectives = {
			{Type = "Choice", Target = "SpeciesSelection", Text = "Choose or awaken your species"},
			{Type = "Train", Target = "TrainingRoom", Text = "Complete basic training"},
		},
		Rewards = {
			XP = 100,
			Moonstones = 50,
		},
		Next = "EclipseDisturbance",
	},

	EclipseDisturbance = {
		Id = "EclipseDisturbance",
		Title = "The Eclipse Prophecy – Disturbance",
		Description = "Strange magical fluctuations are reported around town. Investigate the source.",
		Type = "Main",
		Objectives = {
			{Type = "Explore", Target = "TownSquare", Text = "Investigate the Town Square"},
			{Type = "Talk", Target = "ElderMira", Text = "Speak with Elder Mira"},
			{Type = "Collect", Target = "EclipseFragment", Count = 1, Text = "Recover a strange fragment"},
		},
		Rewards = {
			XP = 200,
			Moonstones = 100,
			Items = {"EclipseFragment"},
		},
		Next = "FactionChoice",
	},

	FactionChoice = {
		Id = "FactionChoice",
		Title = "Choosing Sides",
		Description = "Different factions seek the Eclipse Relic for their own reasons. Decide where your loyalty begins.",
		Type = "Main",
		Objectives = {
			{Type = "Talk", Target = "VampireElder", Text = "Hear the Vampire House offer"},
			{Type = "Talk", Target = "CovenLeader", Text = "Hear the Coven offer"},
			{Type = "Talk", Target = "PackAlpha", Text = "Hear the Pack offer"},
			{Type = "Choice", Target = "JoinFaction", Text = "Choose a starting faction (or remain independent)"},
		},
		Rewards = {
			XP = 150,
			Moonstones = 75,
		},
	},

	-- Side / Species quests
	VampireDynasty = {
		Id = "VampireDynasty",
		Title = "Vampire Dynasty",
		Description = "Investigate a forgotten bloodline and rise within the vampire houses.",
		Type = "Side",
		RequiredSpecies = "Vampire",
		Objectives = {
			{Type = "Explore", Target = "VampireManor", Text = "Enter the Vampire Manor"},
			{Type = "Collect", Target = "FamilyPortrait", Count = 3, Text = "Recover lost family records"},
		},
		Rewards = {
			XP = 300,
			Moonstones = 150,
			Reputation = {Faction = "VampireHouses", Amount = 50},
		},
	},

	TheWitchsGrimoire = {
		Id = "TheWitchsGrimoire",
		Title = "The Witch's Grimoire",
		Description = "Recover pages of an ancient grimoire scattered across the ritual grounds.",
		Type = "Side",
		RequiredSpecies = "Witch",
		Objectives = {
			{Type = "Collect", Target = "GrimoirePage", Count = 5, Text = "Collect Grimoire Pages"},
			{Type = "Ritual", Target = "RitualGrounds", Text = "Perform the Binding Ritual"},
		},
		Rewards = {
			XP = 280,
			Moonstones = 140,
		},
	},

	TheWolfsAwakening = {
		Id = "TheWolfsAwakening",
		Title = "The Wolf's Awakening",
		Description = "Learn to control the transformation and earn the trust of a pack.",
		Type = "Side",
		RequiredSpecies = "Werewolf",
		Objectives = {
			{Type = "Transform", Target = "WolfForm", Text = "Successfully transform under the moon"},
			{Type = "Talk", Target = "PackAlpha", Text = "Prove yourself to the Alpha"},
		},
		Rewards = {
			XP = 250,
			Moonstones = 120,
		},
	},

	TheHereticPath = {
		Id = "TheHereticPath",
		Title = "The Heretic Path",
		Description = "A rare and dangerous path for those who can siphon. Follow it carefully.",
		Type = "Side",
		RequiredSpecies = "Siphoner",
		Objectives = {
			{Type = "Collect", Target = "EclipseFragment", Count = 3, Text = "Gather Eclipse Fragments"},
			{Type = "Talk", Target = "HereticMentor", Text = "Seek the mentor who knows the old ways"},
			{Type = "Ritual", Target = "HiddenChamber", Text = "Complete the Heretic Ritual"},
		},
		Rewards = {
			XP = 500,
			Moonstones = 250,
			EvolutionUnlock = "Heretic",
		},
	},
}

function QuestConfig.Get(id)
	return QuestConfig.Quests[id]
end

return QuestConfig
]]></ProtectedString>
