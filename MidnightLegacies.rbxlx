      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">SpeciesConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Species Configuration
	All species data lives here. Add new species or evolutions by extending the tables.
]]

local SpeciesConfig = {}

SpeciesConfig.Species = {
	Human = {
		DisplayName = "Human",
		Description = "Resourceful and adaptable. Masters of investigation, alchemy and enchanted weaponry.",
		ResourceName = "Focus",
		ResourceColor = Color3.fromRGB(200, 200, 220),
		BaseStats = {
			Health = 100,
			Speed = 16,
			Strength = 10,
			Defense = 10,
		},
		StartingAbilities = {"EnchantedStrike", "TacticalDodge", "ProtectiveCharm"},
		Weaknesses = {},
		CanEvolveTo = {"Hunter", "Alchemist"},
	},

	Vampire = {
		DisplayName = "Vampire",
		Description = "Immortal predators of the night. Fast, strong, and sustained by blood.",
		ResourceName = "Blood",
		ResourceColor = Color3.fromRGB(180, 30, 40),
		BaseStats = {
			Health = 120,
			Speed = 22,
			Strength = 18,
			Defense = 12,
		},
		StartingAbilities = {"ShadowDash", "BloodStrike", "RapidRegen"},
		Weaknesses = {"Sunlight", "EnchantedWeapons"},
		CanEvolveTo = {"AncientVampire", "OriginalVampire"},
	},

	Witch = {
		DisplayName = "Witch",
		Description = "Wielders of arcane energy. Spells, rituals and bloodline power.",
		ResourceName = "Mana",
		ResourceColor = Color3.fromRGB(120, 80, 220),
		BaseStats = {
			Health = 90,
			Speed = 16,
			Strength = 8,
			Defense = 8,
		},
		StartingAbilities = {"ArcaneBolt", "TelekineticPush", "MagicalBarrier"},
		Weaknesses = {"MagicalExhaustion"},
		CanEvolveTo = {"BloodlineWitch", "AncestralWitch", "Siphoner"},
	},

	Siphoner = {
		DisplayName = "Siphoner",
		Description = "Cannot generate magic naturally. Absorbs power from the world and other supernaturals.",
		ResourceName = "AbsorbedMagic",
		ResourceColor = Color3.fromRGB(0, 200, 180),
		BaseStats = {
			Health = 95,
			Speed = 17,
			Strength = 10,
			Defense = 9,
		},
		StartingAbilities = {"Siphon", "AbsorbedBolt", "DrainTouch"},
		Weaknesses = {"NoNaturalRegen"},
		CanEvolveTo = {"Heretic"},
	},

	Werewolf = {
		DisplayName = "Werewolf",
		Description = "Beings of the moon and the pack. Overwhelming physical power and transformation.",
		ResourceName = "Rage",
		ResourceColor = Color3.fromRGB(220, 120, 40),
		BaseStats = {
			Health = 140,
			Speed = 20,
			Strength = 22,
			Defense = 16,
		},
		StartingAbilities = {"Pounce", "ClawStrike", "Howl"},
		Weaknesses = {"Silver"},
		CanEvolveTo = {"Alpha", "Hybrid"},
	},
}

-- Rare / evolved forms (unlocked later)
SpeciesConfig.Evolutions = {
	Heretic = {
		DisplayName = "Heretic",
		BaseSpecies = "Siphoner",
		Description = "A siphoner who has claimed vampiric immortality while retaining the ability to absorb magic.",
		Requirements = {
			MinLevel = 40,
			Quest = "TheHereticPath",
			Items = {"EclipseFragment"},
		},
		StatMultipliers = {Health = 1.4, Speed = 1.3, Strength = 1.35},
	},
	AncientVampire = {
		DisplayName = "Ancient Vampire",
		BaseSpecies = "Vampire",
		Description = "Centuries of power condensed into a single immortal form.",
		Requirements = {
			MinLevel = 35,
			Quest = "VampireDynasty",
		},
		StatMultipliers = {Health = 1.5, Speed = 1.4, Strength = 1.5},
	},
	OriginalVampire = {
		DisplayName = "Original Vampire",
		BaseSpecies = "Vampire",
		Description = "The apex of vampiric evolution. Extremely rare.",
		Requirements = {
			MinLevel = 55,
			Quest = "OriginalRitual",
			Items = {"EclipseRelic", "AncientBlood"},
		},
		StatMultipliers = {Health = 2.0, Speed = 1.6, Strength = 1.8},
	},
	Alpha = {
		DisplayName = "Alpha",
		BaseSpecies = "Werewolf",
		Description = "Leader of the pack. Commands both wolf and human form with mastery.",
		Requirements = {
			MinLevel = 30,
			FactionRank = "PackLeader",
		},
		StatMultipliers = {Health = 1.6, Strength = 1.7},
	},
	Hybrid = {
		DisplayName = "Hybrid",
		BaseSpecies = "Werewolf", -- or Vampire depending on path
		Description = "A fusion of vampire and werewolf nature. Rare and unstable.",
		Requirements = {
			MinLevel = 45,
			Quest = "HybridAwakening",
		},
		StatMultipliers = {Health = 1.7, Speed = 1.5, Strength = 1.6},
	},
}

function SpeciesConfig.GetSpecies(name)
	return SpeciesConfig.Species[name]
end

function SpeciesConfig.GetEvolution(name)
	return SpeciesConfig.Evolutions[name]
end

return SpeciesConfig
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">AbilityConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Ability Configuration
	Define every ability here. CombatService reads from this table.
]]

local AbilityConfig = {}

AbilityConfig.Abilities = {
	-- Vampire
	ShadowDash = {
		DisplayName = "Shadow Dash",
		Species = "Vampire",
		Cooldown = 6,
		ResourceCost = 15,
		Range = 40,
		Description = "Dash forward through shadow, dealing light damage on impact.",
		Type = "Movement",
	},
	BloodStrike = {
		DisplayName = "Blood Strike",
		Species = "Vampire",
		Cooldown = 4,
		ResourceCost = 20,
		Range = 12,
		Description = "A powerful melee strike that returns a portion of damage as blood.",
		Type = "Melee",
	},
	RapidRegen = {
		DisplayName = "Rapid Regeneration",
		Species = "Vampire",
		Cooldown = 18,
		ResourceCost = 35,
		Range = 0,
		Description = "Instantly restore a large amount of health. Costs significant blood.",
		Type = "Self",
	},
	Compel = {
		DisplayName = "Compel",
		Species = "Vampire",
		Cooldown = 25,
		ResourceCost = 40,
		Range = 20,
		Description = "Temporarily influence an eligible target (consent-based RP safeguards apply).",
		Type = "Utility",
	},
	Bloodlust = {
		DisplayName = "Bloodlust",
		Species = "Vampire",
		Cooldown = 45,
		ResourceCost = 50,
		Range = 0,
		Description = "Enter a temporary state of heightened speed and strength.",
		Type = "Buff",
	},

	-- Witch
	ArcaneBolt = {
		DisplayName = "Arcane Bolt",
		Species = "Witch",
		Cooldown = 2.5,
		ResourceCost = 12,
		Range = 60,
		Description = "Fire a bolt of pure magical energy.",
		Type = "Ranged",
	},
	TelekineticPush = {
		DisplayName = "Telekinetic Push",
		Species = "Witch",
		Cooldown = 7,
		ResourceCost = 25,
		Range = 30,
		Description = "Forcefully push enemies away and interrupt them.",
		Type = "CrowdControl",
	},
	MagicalBarrier = {
		DisplayName = "Magical Barrier",
		Species = "Witch",
		Cooldown = 16,
		ResourceCost = 30,
		Range = 0,
		Description = "Create a temporary shield that absorbs damage.",
		Type = "Self",
	},
	BindingSpell = {
		DisplayName = "Binding Spell",
		Species = "Witch",
		Cooldown = 14,
		ResourceCost = 28,
		Range = 25,
		Description = "Root a target in place for a short duration.",
		Type = "CrowdControl",
	},
	ElementalBurst = {
		DisplayName = "Elemental Burst",
		Species = "Witch",
		Cooldown = 12,
		ResourceCost = 40,
		Range = 20,
		Description = "Release a burst of elemental energy around you.",
		Type = "AoE",
	},

	-- Siphoner
	Siphon = {
		DisplayName = "Siphon",
		Species = "Siphoner",
		Cooldown = 8,
		ResourceCost = 0,
		Range = 18,
		Description = "Absorb magical energy from a target or enchanted object.",
		Type = "Resource",
	},
	AbsorbedBolt = {
		DisplayName = "Absorbed Bolt",
		Species = "Siphoner",
		Cooldown = 3,
		ResourceCost = 15,
		Range = 55,
		Description = "Fire a bolt using previously absorbed magic.",
		Type = "Ranged",
	},
	DrainTouch = {
		DisplayName = "Drain Touch",
		Species = "Siphoner",
		Cooldown = 10,
		ResourceCost = 10,
		Range = 8,
		Description = "Drain health and magic from a close target.",
		Type = "Melee",
	},

	-- Werewolf
	Pounce = {
		DisplayName = "Pounce",
		Species = "Werewolf",
		Cooldown = 8,
		ResourceCost = 20,
		Range = 35,
		Description = "Leap at a target, dealing heavy damage on landing.",
		Type = "Movement",
	},
	ClawStrike = {
		DisplayName = "Claw Strike",
		Species = "Werewolf",
		Cooldown = 3,
		ResourceCost = 12,
		Range = 10,
		Description = "A rapid series of claw attacks.",
		Type = "Melee",
	},
	Howl = {
		DisplayName = "Howl",
		Species = "Werewolf",
		Cooldown = 20,
		ResourceCost = 25,
		Range = 40,
		Description = "Inspire nearby pack members and intimidate enemies.",
		Type = "Buff",
	},
	WolfTransformation = {
		DisplayName = "Wolf Form",
		Species = "Werewolf",
		Cooldown = 60,
		ResourceCost = 40,
		Range = 0,
		Description = "Transform into wolf form. Gains massive physical power.",
		Type = "Transformation",
	},

	-- Human
	EnchantedStrike = {
		DisplayName = "Enchanted Strike",
		Species = "Human",
		Cooldown = 5,
		ResourceCost = 15,
		Range = 12,
		Description = "A precise strike empowered by an enchanted weapon.",
		Type = "Melee",
	},
	TacticalDodge = {
		DisplayName = "Tactical Dodge",
		Species = "Human",
		Cooldown = 7,
		ResourceCost = 10,
		Range = 0,
		Description = "Quickly roll out of harm's way and gain brief invulnerability.",
		Type = "Movement",
	},
	ProtectiveCharm = {
		DisplayName = "Protective Charm",
		Species = "Human",
		Cooldown = 22,
		ResourceCost = 25,
		Range = 0,
		Description = "Activate a charm that reduces incoming supernatural damage.",
		Type = "Self",
	},
	Trap = {
		DisplayName = "Hunter's Trap",
		Species = "Human",
		Cooldown = 15,
		ResourceCost = 20,
		Range = 20,
		Description = "Place a temporary trap that slows and damages enemies.",
		Type = "Utility",
	},
}

function AbilityConfig.Get(name)
	return AbilityConfig.Abilities[name]
end

function AbilityConfig.GetForSpecies(speciesName)
	local list = {}
	for id, data in pairs(AbilityConfig.Abilities) do
		if data.Species == speciesName then
			table.insert(list, id)
		end
	end
	return list
end

return AbilityConfig
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">EvolutionConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Evolution Progression
]]

local EvolutionConfig = {}

-- Visual progression paths shown in the Evolution UI
EvolutionConfig.Paths = {
	Vampire = {
		{Tier = 1, Name = "Vampire", LevelReq = 1},
		{Tier = 2, Name = "Adept Vampire", LevelReq = 15},
		{Tier = 3, Name = "Elder Vampire", LevelReq = 30},
		{Tier = 4, Name = "Ancient Vampire", LevelReq = 35, Evolution = "AncientVampire"},
		{Tier = 5, Name = "Original Vampire", LevelReq = 55, Evolution = "OriginalVampire"},
	},
	Witch = {
		{Tier = 1, Name = "Witch", LevelReq = 1},
		{Tier = 2, Name = "Adept Witch", LevelReq = 12},
		{Tier = 3, Name = "Bloodline Witch", LevelReq = 25},
		{Tier = 4, Name = "Ancestral Witch", LevelReq = 35},
	},
	Siphoner = {
		{Tier = 1, Name = "Siphoner", LevelReq = 1},
		{Tier = 2, Name = "Adept Siphoner", LevelReq = 18},
		{Tier = 3, Name = "Master Siphoner", LevelReq = 32},
		{Tier = 4, Name = "Heretic", LevelReq = 40, Evolution = "Heretic"},
	},
	Werewolf = {
		{Tier = 1, Name = "Newly Awakened", LevelReq = 1},
		{Tier = 2, Name = "Pack Member", LevelReq = 10},
		{Tier = 3, Name = "Experienced Wolf", LevelReq = 22},
		{Tier = 4, Name = "Pack Leader", LevelReq = 30},
		{Tier = 5, Name = "Alpha", LevelReq = 30, Evolution = "Alpha"},
		{Tier = 6, Name = "Hybrid", LevelReq = 45, Evolution = "Hybrid"},
	},
	Human = {
		{Tier = 1, Name = "Human", LevelReq = 1},
		{Tier = 2, Name = "Investigator", LevelReq = 10},
		{Tier = 3, Name = "Hunter", LevelReq = 20},
		{Tier = 4, Name = "Master Hunter", LevelReq = 35},
	},
}

function EvolutionConfig.GetPath(species)
	return EvolutionConfig.Paths[species]
end

return EvolutionConfig
]]></ProtectedString>
        </Properties>
