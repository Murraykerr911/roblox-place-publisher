      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">FactionConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Factions, Covens & Packs
]]

local FactionConfig = {}

FactionConfig.Factions = {
	VampireHouses = {
		DisplayName = "The Vampire Houses",
		Description = "Ancient bloodlines that value power, elegance and control of the night.",
		EmblemColor = Color3.fromRGB(140, 20, 30),
		StartingReputation = 0,
		Ranks = {"Initiate", "Bloodbound", "Elder", "Lord", "High Lord"},
	},
	WitchCovens = {
		DisplayName = "The Covens",
		Description = "Circles of witches bound by bloodline, knowledge and ritual.",
		EmblemColor = Color3.fromRGB(90, 50, 180),
		StartingReputation = 0,
		Ranks = {"Novice", "Adept", "Circle Member", "High Witch", "Matriarch"},
	},
	WerewolfPacks = {
		DisplayName = "The Packs",
		Description = "Tight-knit groups of werewolves who value loyalty, strength and the moon.",
		EmblemColor = Color3.fromRGB(180, 100, 30),
		StartingReputation = 0,
		Ranks = {"Omega", "Member", "Beta", "Lieutenant", "Alpha"},
	},
	HunterOrder = {
		DisplayName = "The Hunter Order",
		Description = "Humans and allies dedicated to understanding and, when necessary, containing the supernatural.",
		EmblemColor = Color3.fromRGB(80, 90, 110),
		StartingReputation = 0,
		Ranks = {"Recruit", "Investigator", "Hunter", "Veteran", "Commander"},
	},
	Independents = {
		DisplayName = "Independents",
		Description = "Those who walk alone or form temporary alliances.",
		EmblemColor = Color3.fromRGB(120, 120, 140),
		StartingReputation = 0,
		Ranks = {"Lone Wolf"},
	},
}

function FactionConfig.Get(name)
	return FactionConfig.Factions[name]
end

return FactionConfig
]]></ProtectedString>
        </Properties>
