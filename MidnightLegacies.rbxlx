      <Item class="LocalScript" referent="RBX18">
        <Properties>
          <string name="Name">ClientMain</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Client Main
	Place this LocalScript in StarterPlayerScripts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Wait for remotes
local function waitForRemote(name)
	return ReplicatedStorage:WaitForChild(name, 10)
end

local RequestProfile = waitForRemote("RequestProfile")
local ProfileUpdated = waitForRemote("ProfileUpdated")
local SelectSpecies = waitForRemote("SelectSpecies")

local currentProfile = nil

-- Simple notification
local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Midnight Legacies",
			Text = text,
			Duration = 4,
		})
	end)
end

ProfileUpdated.OnClientEvent:Connect(function(profile)
	currentProfile = profile
	print("[Client] Profile received – Species:", profile.Species, "Level:", profile.Level)
	notify("Welcome, " .. (profile.Title or "Newcomer") .. " • " .. profile.Species)
end)

-- Request profile once everything is ready
task.wait(1)
RequestProfile:FireServer()

-- Expose a simple global for other client scripts
_G.MidnightLegacies = {
	GetProfile = function()
		return currentProfile
	end,
	SelectSpecies = function(speciesName)
		SelectSpecies:FireServer(speciesName)
	end,
}

print("[Midnight Legacies] Client framework loaded")
]]></ProtectedString>
