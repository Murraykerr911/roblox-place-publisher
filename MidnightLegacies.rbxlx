      <Item class="LocalScript" referent="RBX21">
        <Properties>
          <string name="Name">CharacterCreation</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Character Creation & Species Selection UI
	Place this LocalScript inside a ScreenGui named "CharacterCreationGui" in StarterGui,
	or let it create the ScreenGui itself.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Create the ScreenGui if it doesn't exist
local screenGui = playerGui:FindFirstChild("CharacterCreationGui")
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "CharacterCreationGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = playerGui
end

-- Colors – gothic palette
local Colors = {
	Background = Color3.fromRGB(12, 10, 18),
	Panel = Color3.fromRGB(22, 18, 32),
	Accent = Color3.fromRGB(140, 40, 60),
	Accent2 = Color3.fromRGB(90, 60, 160),
	Text = Color3.fromRGB(230, 220, 240),
	Muted = Color3.fromRGB(160, 150, 170),
	Vampire = Color3.fromRGB(160, 30, 45),
	Witch = Color3.fromRGB(110, 70, 200),
	Werewolf = Color3.fromRGB(190, 110, 40),
	Human = Color3.fromRGB(140, 150, 170),
	Siphoner = Color3.fromRGB(0, 180, 160),
}

local speciesData = {
	{Id = "Vampire", Name = "Vampire", Desc = "Immortal predator of the night. Speed, strength and blood.", Color = Colors.Vampire},
	{Id = "Witch", Name = "Witch", Desc = "Master of spells, rituals and arcane bloodlines.", Color = Colors.Witch},
	{Id = "Werewolf", Name = "Werewolf", Desc = "Child of the moon. Pack, rage and transformation.", Color = Colors.Werewolf},
	{Id = "Human", Name = "Human", Desc = "Resourceful hunter, alchemist and investigator.", Color = Colors.Human},
	{Id = "Siphoner", Name = "Siphoner", Desc = "Absorbs magic from the world. Path to the Heretic.", Color = Colors.Siphoner},
}

-- Main frame
local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.new(1, 0, 1, 0)
main.BackgroundColor3 = Colors.Background
main.BorderSizePixel = 0
main.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 80)
title.Position = UDim2.new(0, 0, 0.08, 0)
title.BackgroundTransparency = 1
title.Text = "MIDNIGHT LEGACIES"
title.TextColor3 = Colors.Text
title.TextSize = 42
title.Font = Enum.Font.GothamBold
title.Parent = main

local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(1, 0, 0, 30)
subtitle.Position = UDim2.new(0, 0, 0.08, 70)
subtitle.BackgroundTransparency = 1
subtitle.Text = "Choose your supernatural path"
subtitle.TextColor3 = Colors.Muted
subtitle.TextSize = 18
subtitle.Font = Enum.Font.Gotham
subtitle.Parent = main

-- Species cards container
local container = Instance.new("Frame")
container.Size = UDim2.new(0.9, 0, 0.55, 0)
container.Position = UDim2.new(0.05, 0, 0.28, 0)
container.BackgroundTransparency = 1
container.Parent = main

local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Padding = UDim.new(0, 16)
layout.Parent = container

local selectedSpecies = nil
local cards = {}

local function createCard(data)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(0, 180, 1, 0)
	card.BackgroundColor3 = Colors.Panel
	card.BorderSizePixel = 0
	card.Parent = container

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = data.Color
	stroke.Thickness = 2
	stroke.Transparency = 0.6
	stroke.Parent = card

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -16, 0, 40)
	nameLabel.Position = UDim2.new(0, 8, 0, 20)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = data.Name
	nameLabel.TextColor3 = data.Color
	nameLabel.TextSize = 22
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Parent = card

	local descLabel = Instance.new("TextLabel")
	descLabel.Size = UDim2.new(1, -20, 0, 100)
	descLabel.Position = UDim2.new(0, 10, 0, 70)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = data.Desc
	descLabel.TextColor3 = Colors.Muted
	descLabel.TextSize = 14
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextWrapped = true
	descLabel.TextYAlignment = Enum.TextYAlignment.Top
	descLabel.Parent = card

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -24, 0, 36)
	button.Position = UDim2.new(0, 12, 1, -50)
	button.BackgroundColor3 = data.Color
	button.Text = "Select"
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 16
	button.Font = Enum.Font.GothamBold
	button.Parent = card

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = button

	button.MouseButton1Click:Connect(function()
		selectedSpecies = data.Id
		for _, c in pairs(cards) do
			c.Stroke.Transparency = 0.6
		end
		stroke.Transparency = 0
		notify("Selected: " .. data.Name)
	end)

	cards[data.Id] = {Card = card, Stroke = stroke}
	return card
end

for _, data in ipairs(speciesData) do
	createCard(data)
end

-- Confirm button
local confirm = Instance.new("TextButton")
confirm.Size = UDim2.new(0, 260, 0, 50)
confirm.Position = UDim2.new(0.5, -130, 0.88, 0)
confirm.BackgroundColor3 = Colors.Accent
confirm.Text = "Begin Your Legacy"
confirm.TextColor3 = Color3.new(1, 1, 1)
confirm.TextSize = 20
confirm.Font = Enum.Font.GothamBold
confirm.Parent = main

local confirmCorner = Instance.new("UICorner")
confirmCorner.CornerRadius = UDim.new(0, 10)
confirmCorner.Parent = confirm

confirm.MouseButton1Click:Connect(function()
	if not selectedSpecies then
		notify("Please select a species first")
		return
	end

	if _G.MidnightLegacies and _G.MidnightLegacies.SelectSpecies then
		_G.MidnightLegacies.SelectSpecies(selectedSpecies)
	end

	-- Fade out
	local tween = TweenService:Create(main, TweenInfo.new(0.6), {BackgroundTransparency = 1})
	tween:Play()
	tween.Completed:Connect(function()
		screenGui:Destroy()
	end)
end)

function notify(text)
	-- Simple print for now; replace with proper toast later
	print("[UI]", text)
end

print("[Midnight Legacies] Character Creation UI ready")
]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="RBX22">
      <Properties>
        <string name="Name">MidnightHUD</string>
        <bool name="ResetOnSpawn">false</bool>
        <bool name="IgnoreGuiInset">true</bool>
        <int name="ZIndexBehavior">1</int>
      </Properties>
      <Item class="LocalScript" referent="RBX23">
        <Properties>
          <string name="Name">HUD</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Main HUD
	Creates a dark gothic HUD with health, resource, level, and ability slots.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MidnightHUD"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = playerGui

local Colors = {
	BarBG = Color3.fromRGB(20, 16, 28),
	Health = Color3.fromRGB(160, 40, 50),
	Resource = Color3.fromRGB(100, 60, 180),
	Text = Color3.fromRGB(230, 220, 240),
	Muted = Color3.fromRGB(150, 140, 160),
}

-- Bottom left status panel
local status = Instance.new("Frame")
status.Name = "StatusPanel"
status.Size = UDim2.new(0, 280, 0, 90)
status.Position = UDim2.new(0, 20, 1, -120)
status.BackgroundColor3 = Colors.BarBG
status.BackgroundTransparency = 0.25
status.BorderSizePixel = 0
status.Parent = screenGui

local statusCorner = Instance.new("UICorner")
statusCorner.CornerRadius = UDim.new(0, 10)
statusCorner.Parent = status

-- Health bar
local healthBG = Instance.new("Frame")
healthBG.Size = UDim2.new(1, -20, 0, 14)
healthBG.Position = UDim2.new(0, 10, 0, 18)
healthBG.BackgroundColor3 = Color3.fromRGB(40, 20, 25)
healthBG.BorderSizePixel = 0
healthBG.Parent = status

local healthBar = Instance.new("Frame")
healthBar.Name = "HealthBar"
healthBar.Size = UDim2.new(1, 0, 1, 0)
healthBar.BackgroundColor3 = Colors.Health
healthBar.BorderSizePixel = 0
healthBar.Parent = healthBG

local healthCorner = Instance.new("UICorner")
healthCorner.CornerRadius = UDim.new(0, 4)
healthCorner.Parent = healthBG
local healthBarCorner = Instance.new("UICorner")
healthBarCorner.CornerRadius = UDim.new(0, 4)
healthBarCorner.Parent = healthBar

-- Resource bar
local resourceBG = Instance.new("Frame")
resourceBG.Size = UDim2.new(1, -20, 0, 14)
resourceBG.Position = UDim2.new(0, 10, 0, 40)
resourceBG.BackgroundColor3 = Color3.fromRGB(30, 25, 45)
resourceBG.BorderSizePixel = 0
resourceBG.Parent = status

local resourceBar = Instance.new("Frame")
resourceBar.Name = "ResourceBar"
resourceBar.Size = UDim2.new(0.8, 0, 1, 0)
resourceBar.BackgroundColor3 = Colors.Resource
resourceBar.BorderSizePixel = 0
resourceBar.Parent = resourceBG

local resCorner = Instance.new("UICorner")
resCorner.CornerRadius = UDim.new(0, 4)
resCorner.Parent = resourceBG
local resBarCorner = Instance.new("UICorner")
resBarCorner.CornerRadius = UDim.new(0, 4)
resBarCorner.Parent = resourceBar

-- Level / Title
local levelLabel = Instance.new("TextLabel")
levelLabel.Name = "LevelLabel"
levelLabel.Size = UDim2.new(1, -20, 0, 20)
levelLabel.Position = UDim2.new(0, 10, 0, 62)
levelLabel.BackgroundTransparency = 1
levelLabel.Text = "Lv. 1  •  Newcomer  •  Human"
levelLabel.TextColor3 = Colors.Text
levelLabel.TextSize = 14
levelLabel.Font = Enum.Font.Gotham
levelLabel.TextXAlignment = Enum.TextXAlignment.Left
levelLabel.Parent = status

-- Ability bar (bottom center)
local abilityBar = Instance.new("Frame")
abilityBar.Name = "AbilityBar"
abilityBar.Size = UDim2.new(0, 320, 0, 64)
abilityBar.Position = UDim2.new(0.5, -160, 1, -90)
abilityBar.BackgroundTransparency = 1
abilityBar.Parent = screenGui

local abilityLayout = Instance.new("UIListLayout")
abilityLayout.FillDirection = Enum.FillDirection.Horizontal
abilityLayout.Padding = UDim.new(0, 8)
abilityLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
abilityLayout.Parent = abilityBar

for i = 1, 4 do
	local slot = Instance.new("Frame")
	slot.Name = "AbilitySlot" .. i
	slot.Size = UDim2.new(0, 56, 0, 56)
	slot.BackgroundColor3 = Color3.fromRGB(25, 20, 35)
	slot.BorderSizePixel = 0
	slot.Parent = abilityBar

	local slotCorner = Instance.new("UICorner")
	slotCorner.CornerRadius = UDim.new(0, 8)
	slotCorner.Parent = slot

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(80, 60, 110)
	stroke.Thickness = 1.5
	stroke.Parent = slot

	local key = Instance.new("TextLabel")
	key.Size = UDim2.new(1, 0, 1, 0)
	key.BackgroundTransparency = 1
	key.Text = tostring(i)
	key.TextColor3 = Colors.Muted
	key.TextSize = 18
	key.Font = Enum.Font.GothamBold
	key.Parent = slot
end

-- Mini currency
local currency = Instance.new("TextLabel")
currency.Name = "Moonstones"
currency.Size = UDim2.new(0, 160, 0, 28)
currency.Position = UDim2.new(1, -180, 0, 20)
currency.BackgroundTransparency = 1
currency.Text = "✦ 50 Moonstones"
currency.TextColor3 = Color3.fromRGB(200, 180, 255)
currency.TextSize = 16
currency.Font = Enum.Font.GothamMedium
currency.TextXAlignment = Enum.TextXAlignment.Right
currency.Parent = screenGui

print("[Midnight Legacies] HUD created")
]]></ProtectedString>
