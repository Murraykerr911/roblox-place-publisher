  <Item class="ServerScriptService" referent="RBX10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX11">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – DataService
	Handles player profile creation, loading and saving.
	Uses DataStoreService. Add proper error handling & retries in production.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SpeciesConfig = require(ReplicatedStorage.Modules.SpeciesConfig)

local DataService = {}
DataService.__index = DataService

local PROFILE_STORE = DataStoreService:GetDataStore("MidnightLegacies_Profiles_v1")

local DEFAULT_PROFILE = {
	Name = "",
	Title = "Newcomer",
	Species = "Human",
	Evolution = nil,
	Level = 1,
	XP = 0,
	Moonstones = 50,
	Health = 100,
	Resource = 100, -- Blood / Mana / Rage / Focus
	MaxResource = 100,
	UnlockedAbilities = {},
	EquippedAbilities = {},
	Inventory = {},
	Quests = {
		Active = {},
		Completed = {},
	},
	Faction = "Independents",
	Reputation = {},
	Stats = {
		Strength = 10,
		Defense = 10,
		Speed = 16,
	},
	Discoveries = {},
	Settings = {
		MusicVolume = 0.7,
		SFXVolume = 0.8,
		ShowDamageNumbers = true,
	},
	LastLogin = 0,
}

function DataService.new()
	local self = setmetatable({}, DataService)
	self.Profiles = {} -- [userId] = profile table
	return self
end

function DataService:CreateDefaultProfile(player)
	local profile = table.clone(DEFAULT_PROFILE)
	profile.Name = player.Name
	profile.UnlockedAbilities = SpeciesConfig.GetSpecies("Human").StartingAbilities
	profile.EquippedAbilities = {table.unpack(profile.UnlockedAbilities, 1, 3)}
	profile.LastLogin = os.time()
	return profile
end

function DataService:LoadProfile(player)
	local userId = player.UserId
	local success, data = pcall(function()
		return PROFILE_STORE:GetAsync("Player_" .. userId)
	end)

	if success and data then
		-- Merge with defaults in case new fields were added
		for k, v in pairs(DEFAULT_PROFILE) do
			if data[k] == nil then
				data[k] = typeof(v) == "table" and table.clone(v) or v
			end
		end
		self.Profiles[userId] = data
		print("[DataService] Loaded profile for", player.Name)
	else
		local profile = self:CreateDefaultProfile(player)
		self.Profiles[userId] = profile
		print("[DataService] Created new profile for", player.Name)
	end

	return self.Profiles[userId]
end

function DataService:SaveProfile(player)
	local userId = player.UserId
	local profile = self.Profiles[userId]
	if not profile then return end

	profile.LastLogin = os.time()
	local success, err = pcall(function()
		PROFILE_STORE:SetAsync("Player_" .. userId, profile)
	end)

	if not success then
		warn("[DataService] Failed to save profile for", player.Name, err)
	else
		print("[DataService] Saved profile for", player.Name)
	end
end

function DataService:GetProfile(player)
	return self.Profiles[player.UserId]
end

function DataService:UpdateProfile(player, key, value)
	local profile = self.Profiles[player.UserId]
	if profile then
		profile[key] = value
	end
end

function DataService:AddXP(player, amount)
	local profile = self:GetProfile(player)
	if not profile then return end

	profile.XP += amount
	local required = profile.Level * 100 -- simple curve

	while profile.XP >= required do
		profile.XP -= required
		profile.Level += 1
		required = profile.Level * 100
		-- Fire level-up event here later
	end
end

function DataService:AddMoonstones(player, amount)
	local profile = self:GetProfile(player)
	if profile then
		profile.Moonstones += amount
	end
end

-- Auto-save on leave
Players.PlayerRemoving:Connect(function(player)
	-- The service instance will handle this when properly connected
end)

return DataService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">CombatService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Combat Service (skeleton)
	Handles ability usage validation and basic damage.
	Expand with proper hit detection, VFX, and animations.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local AbilityConfig = require(ReplicatedStorage.Modules.AbilityConfig)

local CombatService = {}
CombatService.__index = CombatService

function CombatService.new(dataService)
	local self = setmetatable({}, CombatService)
	self.DataService = dataService
	self.Cooldowns = {} -- [userId][abilityId] = tick()
	return self
end

function CombatService:CanUseAbility(player, abilityId)
	local profile = self.DataService:GetProfile(player)
	if not profile then return false, "No profile" end

	local ability = AbilityConfig.Get(abilityId)
	if not ability then return false, "Invalid ability" end

	-- Check if unlocked / equipped
	local unlocked = false
	for _, id in ipairs(profile.UnlockedAbilities) do
		if id == abilityId then unlocked = true break end
	end
	if not unlocked then return false, "Ability not unlocked" end

	-- Cooldown
	local userCd = self.Cooldowns[player.UserId]
	if userCd and userCd[abilityId] and tick() < userCd[abilityId] then
		return false, "On cooldown"
	end

	-- Resource
	if profile.Resource < ability.ResourceCost then
		return false, "Not enough resource"
	end

	return true, ability
end

function CombatService:UseAbility(player, abilityId, targetPosition)
	local ok, result = self:CanUseAbility(player, abilityId)
	if not ok then
		return false, result
	end

	local ability = result
	local profile = self.DataService:GetProfile(player)

	-- Spend resource
	profile.Resource = math.max(0, profile.Resource - ability.ResourceCost)

	-- Set cooldown
	self.Cooldowns[player.UserId] = self.Cooldowns[player.UserId] or {}
	self.Cooldowns[player.UserId][abilityId] = tick() + ability.Cooldown

	-- TODO: Apply actual effects, spawn VFX, play animations
	-- For now just log
	print(string.format("[Combat] %s used %s", player.Name, ability.DisplayName))

	return true, ability
end

return CombatService
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="RBX14">
      <Properties>
        <string name="Name">MainServer</string>
        <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Main Server Bootstrap
	Place this Script in ServerScriptService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- Ensure folders exist
local modulesFolder = ReplicatedStorage:FindFirstChild("Modules") or Instance.new("Folder")
modulesFolder.Name = "Modules"
modulesFolder.Parent = ReplicatedStorage

local servicesFolder = ServerScriptService:FindFirstChild("Services") or Instance.new("Folder")
servicesFolder.Name = "Services"
servicesFolder.Parent = ServerScriptService

-- Require services (they must be ModuleScripts)
local DataService = require(servicesFolder:WaitForChild("DataService")).new()

-- Simple remote events for client ↔ server communication
local function createRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = ReplicatedStorage
	return r
end

local Remotes = {
	RequestProfile = createRemote("RequestProfile"),
	ProfileUpdated = createRemote("ProfileUpdated"),
	SelectSpecies = createRemote("SelectSpecies"),
	UseAbility = createRemote("UseAbility"),
	AcceptQuest = createRemote("AcceptQuest"),
	CompleteObjective = createRemote("CompleteObjective"),
}

-- Player join
Players.PlayerAdded:Connect(function(player)
	local profile = DataService:LoadProfile(player)

	-- Give the client their profile
	Remotes.RequestProfile.OnServerEvent:Connect(function(requestingPlayer)
		if requestingPlayer == player then
			Remotes.ProfileUpdated:FireClient(player, profile)
		end
	end)

	-- Species selection (first time or via menu)
	Remotes.SelectSpecies.OnServerEvent:Connect(function(requestingPlayer, speciesName)
		if requestingPlayer ~= player then return end
		local SpeciesConfig = require(modulesFolder.SpeciesConfig)
		local speciesData = SpeciesConfig.GetSpecies(speciesName)
		if not speciesData then return end

		profile.Species = speciesName
		profile.UnlockedAbilities = speciesData.StartingAbilities
		profile.EquippedAbilities = {table.unpack(speciesData.StartingAbilities, 1, 3)}
		profile.Stats = table.clone(speciesData.BaseStats)
		profile.Health = speciesData.BaseStats.Health
		profile.MaxResource = 100
		profile.Resource = 100

		DataService:SaveProfile(player)
		Remotes.ProfileUpdated:FireClient(player, profile)
		print(player.Name, "selected species:", speciesName)
	end)

	print("[Midnight Legacies] Player joined:", player.Name)
end)

Players.PlayerRemoving:Connect(function(player)
	DataService:SaveProfile(player)
	DataService.Profiles[player.UserId] = nil
end)

-- Basic day/night cycle
local Lighting = game:GetService("Lighting")
local dayLength = 12 * 60 -- 12 real minutes = full day for testing

task.spawn(function()
	while true do
		for i = 0, 24, 0.1 do
			Lighting.ClockTime = i
			task.wait(dayLength / 240)
		end
	end
end)

print("[Midnight Legacies] Server started – framework ready")
]]></ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX15">
      <Properties>
        <string name="Name">MapBuilder</string>
        <ProtectedString name="Source"><![CDATA[--[[
	Midnight Legacies – Simple Map Builder
	Creates basic region placeholders so the world isn't an empty baseplate.
	Replace these with real models / terrain later.
]]

local Workspace = game:GetService("Workspace")

-- Clear default baseplate if present
local baseplate = Workspace:FindFirstChild("Baseplate")
if baseplate then baseplate:Destroy() end

local function createPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = Workspace
	return p
end

local function createRegionLabel(position, text)
	local part = createPart({
		Name = "RegionLabel_" .. text,
		Size = Vector3.new(20, 1, 8),
		Position = position + Vector3.new(0, 8, 0),
		Color = Color3.fromRGB(40, 30, 55),
		Material = Enum.Material.Neon,
		Transparency = 0.3,
	})
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 200, 0, 50)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(220, 200, 255)
	label.TextSize = 24
	label.Font = Enum.Font.GothamBold
	label.Parent = bb
end

-- Ground
createPart({
	Name = "Ground",
	Size = Vector3.new(800, 4, 800),
	Position = Vector3.new(0, -2, 0),
	Color = Color3.fromRGB(25, 30, 22),
	Material = Enum.Material.Grass,
})

-- === MIDNIGHT ACADEMY (center) ===
createPart({
	Name = "AcademyFloor",
	Size = Vector3.new(120, 2, 100),
	Position = Vector3.new(0, 1, 0),
	Color = Color3.fromRGB(45, 40, 55),
	Material = Enum.Material.Slate,
})
createPart({
	Name = "AcademyMainHall",
	Size = Vector3.new(60, 25, 40),
	Position = Vector3.new(0, 13.5, -10),
	Color = Color3.fromRGB(55, 45, 70),
	Material = Enum.Material.Brick,
})
createPart({
	Name = "AcademyTower",
	Size = Vector3.new(16, 45, 16),
	Position = Vector3.new(40, 23.5, 20),
	Color = Color3.fromRGB(50, 40, 65),
	Material = Enum.Material.Brick,
})
createRegionLabel(Vector3.new(0, 2, 40), "MIDNIGHT ACADEMY")

-- === TOWN (east) ===
createPart({
	Name = "TownSquare",
	Size = Vector3.new(80, 1, 80),
	Position = Vector3.new(200, 0.5, 0),
	Color = Color3.fromRGB(60, 55, 50),
	Material = Enum.Material.Concrete,
})
for i = 1, 5 do
	createPart({
		Name = "TownBuilding" .. i,
		Size = Vector3.new(18, 12 + (i % 3) * 4, 14),
		Position = Vector3.new(170 + (i * 20), 7, -40 + (i % 2) * 50),
		Color = Color3.fromRGB(70, 60, 55),
		Material = Enum.Material.Brick,
	})
end
createRegionLabel(Vector3.new(200, 2, 50), "THE TOWN")

-- === ANCIENT FOREST (west) ===
createPart({
	Name = "ForestGround",
	Size = Vector3.new(200, 2, 200),
	Position = Vector3.new(-220, 0, 0),
	Color = Color3.fromRGB(20, 35, 18),
	Material = Enum.Material.Grass,
})
for i = 1, 25 do
	local x = -220 + math.random(-80, 80)
	local z = math.random(-80, 80)
	createPart({
		Name = "TreeTrunk" .. i,
		Size = Vector3.new(3, 12 + math.random(0, 8), 3),
		Position = Vector3.new(x, 7, z),
		Color = Color3.fromRGB(40, 28, 18),
		Material = Enum.Material.Wood,
	})
	createPart({
		Name = "TreeCanopy" .. i,
		Size = Vector3.new(10, 8, 10),
		Position = Vector3.new(x, 16, z),
		Color = Color3.fromRGB(25, 50, 25),
		Material = Enum.Material.LeafyGrass,
		Shape = Enum.PartType.Ball,
	})
end
createRegionLabel(Vector3.new(-220, 2, 100), "ANCIENT FOREST")

-- === VAMPIRE MANOR (north) ===
createPart({
	Name = "ManorBase",
	Size = Vector3.new(70, 3, 50),
	Position = Vector3.new(0, 1.5, -200),
	Color = Color3.fromRGB(35, 30, 40),
	Material = Enum.Material.Slate,
})
createPart({
	Name = "ManorMain",
	Size = Vector3.new(50, 28, 35),
	Position = Vector3.new(0, 16, -200),
	Color = Color3.fromRGB(45, 35, 50),
	Material = Enum.Material.Brick,
})
createPart({
	Name = "ManorTowerL",
	Size = Vector3.new(14, 38, 14),
	Position = Vector3.new(-30, 20, -210),
	Color = Color3.fromRGB(40, 30, 45),
	Material = Enum.Material.Brick,
})
createPart({
	Name = "ManorTowerR",
	Size = Vector3.new(14, 38, 14),
	Position = Vector3.new(30, 20, -210),
	Color = Color3.fromRGB(40, 30, 45),
	Material = Enum.Material.Brick,
})
createRegionLabel(Vector3.new(0, 2, -160), "VAMPIRE MANOR")

-- === WITCH RITUAL GROUNDS (south-west) ===
createPart({
	Name = "RitualPlatform",
	Size = Vector3.new(40, 2, 40),
	Position = Vector3.new(-150, 1, 180),
	Color = Color3.fromRGB(50, 35, 70),
	Material = Enum.Material.Slate,
})
for i = 1, 8 do
	local angle = (i / 8) * math.pi * 2
	createPart({
		Name = "RitualStone" .. i,
		Size = Vector3.new(3, 8, 3),
		Position = Vector3.new(-150 + math.cos(angle) * 18, 5, 180 + math.sin(angle) * 18),
		Color = Color3.fromRGB(60, 45, 90),
		Material = Enum.Material.Rock,
	})
end
createRegionLabel(Vector3.new(-150, 2, 210), "RITUAL GROUNDS")

-- === MOONLIT LAKE (south) ===
createPart({
	Name = "Lake",
	Size = Vector3.new(100, 2, 70),
	Position = Vector3.new(50, -1, 200),
	Color = Color3.fromRGB(30, 50, 80),
	Material = Enum.Material.Glass,
	Transparency = 0.4,
})
createPart({
	Name = "Pier",
	Size = Vector3.new(8, 1, 25),
	Position = Vector3.new(50, 1, 160),
	Color = Color3.fromRGB(60, 45, 30),
	Material = Enum.Material.Wood,
})
createRegionLabel(Vector3.new(50, 2, 240), "MOONLIT LAKE")

-- Spawn location
local spawn = Instance.new("SpawnLocation")
spawn.Name = "AcademySpawn"
spawn.Size = Vector3.new(12, 1, 12)
spawn.Position = Vector3.new(0, 3, 50)
spawn.Anchored = true
spawn.Neutral = true
spawn.Duration = 0
spawn.Color = Color3.fromRGB(80, 60, 120)
spawn.Material = Enum.Material.Neon
spawn.Parent = Workspace

-- Lighting mood
local Lighting = game:GetService("Lighting")
Lighting.Ambient = Color3.fromRGB(40, 35, 55)
Lighting.OutdoorAmbient = Color3.fromRGB(30, 30, 45)
Lighting.Brightness = 1.5
Lighting.ClockTime = 22 -- start at night
Lighting.FogEnd = 600
Lighting.FogColor = Color3.fromRGB(20, 15, 30)

print("[Midnight Legacies] Map regions created")
]]></ProtectedString>
